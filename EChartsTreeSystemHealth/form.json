{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "CheckBox",
            "name": "UseSymconRoot",
            "caption": "Use Symcon root (entire object tree)",
            "onChange": "ECTH_UpdateTreeRootAvailability($id, $UseSymconRoot);"
        },
        {
            "type": "SelectObject",
            "name": "RootObjectID",
            "caption": "Root category or instance"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "MaxDepth",
                    "caption": "Maximum depth",
                    "minimum": 1,
                    "maximum": 6
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxNodes",
                    "caption": "Maximum nodes",
                    "minimum": 10,
                    "maximum": 3000
                },
                {
                    "type": "CheckBox",
                    "name": "IncludeHidden",
                    "caption": "Include hidden objects"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Categories, instances and variables below the selected root or the Symcon root are read only. Other object types are omitted. The node limit is reported in the chart."
        },
        {
            "type": "ValidationTextBox",
            "name": "VariableNameFilter",
            "caption": "Variable name contains (optional)"
        },
        {
            "type": "Label",
            "caption": "Only matching variable names and their parent categories or instances are shown. Leave empty to skip name filtering."
        },
        {
            "type": "CheckBox",
            "name": "ShowOnlyRuleVariables",
            "caption": "Show only variables with status rules"
        },
        {
            "type": "Label",
            "caption": "When enabled, other variables and empty branches are hidden; parent categories and instances remain. The name filter also applies. Without rules, only the root remains."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Plant status",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Only explicitly selected numeric or Boolean variables determine status. Thresholds use raw values; parents inherit the worst status of visible descendants. Equal warning and critical thresholds mark an alarm directly as critical."
                },
                {
                    "type": "PopupButton",
                    "name": "StatusRuleImport",
                    "caption": "Find and add status variables",
                    "onClick": "ECTH_InvalidateStatusRuleCandidates($id);",
                    "popup": {
                        "caption": "Find status variables",
                        "width": "85%",
                        "closeCaption": "Cancel",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Searches only visible variables below the current Tree root. Existing rules are preserved; review the selection and save the form after adding."
                            },
                            {
                                "type": "RowLayout",
                                "items": [
                                    {
                                        "type": "ValidationTextBox",
                                        "name": "ImportName",
                                        "caption": "Variable name contains",
                                        "value": "Batterie",
                                        "onChange": "ECTH_InvalidateStatusRuleCandidates($id);"
                                    },
                                    {
                                        "type": "Select",
                                        "name": "ImportType",
                                        "caption": "Variable type",
                                        "value": "numeric",
                                        "onChange": "ECTH_InvalidateStatusRuleCandidates($id);",
                                        "options": [
                                            {
                                                "caption": "Integer and Float",
                                                "value": "numeric"
                                            },
                                            {
                                                "caption": "Integer only",
                                                "value": "int"
                                            },
                                            {
                                                "caption": "Float only",
                                                "value": "float"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "RowLayout",
                                "items": [
                                    {
                                        "type": "Select",
                                        "name": "ImportDirection",
                                        "caption": "Alarm direction",
                                        "value": "low",
                                        "options": [
                                            {
                                                "caption": "Higher is worse",
                                                "value": "high"
                                            },
                                            {
                                                "caption": "Lower is worse",
                                                "value": "low"
                                            }
                                        ],
                                        "onChange": "ECTH_UpdateImportThresholdBound($id, $ImportDirection, $ImportWarningAt);"
                                    },
                                    {
                                        "type": "NumberSpinner",
                                        "name": "ImportWarningAt",
                                        "caption": "Warning at",
                                        "value": 40,
                                        "digits": 3,
                                        "onChange": "ECTH_UpdateImportThresholdBound($id, $ImportDirection, $ImportWarningAt);"
                                    },
                                    {
                                        "type": "NumberSpinner",
                                        "name": "ImportCriticalAt",
                                        "caption": "Critical at",
                                        "value": 30,
                                        "digits": 3,
                                        "maximum": 40
                                    }
                                ]
                            },
                            {
                                "type": "Button",
                                "caption": "Search",
                                "onClick": "$statusRuleRows = []; foreach ($StatusRules as $statusRuleRow) { $statusRuleRows[] = $statusRuleRow; } ECTH_SearchStatusRuleCandidates($id, $ImportName, $ImportType, $UseSymconRoot, $RootObjectID, $MaxDepth, $MaxNodes, $IncludeHidden, $VariableNameFilter, json_encode($statusRuleRows));"
                            },
                            {
                                "type": "Label",
                                "name": "ImportSearchSummary",
                                "caption": "Enter a name and click Search."
                            },
                            {
                                "type": "List",
                                "name": "ImportCandidates",
                                "caption": "Matches (select rows to add)",
                                "rowCount": 10,
                                "add": false,
                                "delete": false,
                                "values": [],
                                "columns": [
                                    {
                                        "caption": "Add",
                                        "name": "Selected",
                                        "width": "65px",
                                        "edit": {
                                            "type": "CheckBox"
                                        }
                                    },
                                    {
                                        "caption": "Variable",
                                        "name": "Name",
                                        "width": "200px",
                                        "save": true
                                    },
                                    {
                                        "caption": "Path",
                                        "name": "Path",
                                        "width": "auto",
                                        "save": true
                                    },
                                    {
                                        "caption": "Type",
                                        "name": "VariableType",
                                        "width": "90px",
                                        "save": true
                                    },
                                    {
                                        "name": "VariableID",
                                        "visible": false,
                                        "save": true
                                    }
                                ]
                            }
                        ],
                        "buttons": [
                            {
                                "caption": "Add selected",
                                "onClick": "$statusRuleRows = []; foreach ($StatusRules as $statusRuleRow) { $statusRuleRows[] = $statusRuleRow; } $importCandidateRows = []; foreach ($ImportCandidates as $importCandidateRow) { $importCandidateRows[] = $importCandidateRow; } return ECTH_AddStatusRuleCandidates($id, $ImportName, $ImportType, $ImportDirection, $ImportWarningAt, $ImportCriticalAt, $UseSymconRoot, $RootObjectID, $MaxDepth, $MaxNodes, $IncludeHidden, $VariableNameFilter, json_encode($statusRuleRows), json_encode($importCandidateRows));"
                            }
                        ]
                    }
                },
                {
                    "type": "List",
                    "name": "StatusRules",
                    "caption": "Status variables",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "280px",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable",
                                "validVariableTypes": [
                                    0,
                                    1,
                                    2
                                ]
                            }
                        },
                        {
                            "caption": "Alarm direction",
                            "name": "Direction",
                            "width": "160px",
                            "add": "high",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Higher is worse",
                                        "value": "high"
                                    },
                                    {
                                        "caption": "Lower is worse",
                                        "value": "low"
                                    }
                                ]
                            }
                        },
                        {
                            "caption": "Warning at",
                            "name": "WarningAt",
                            "width": "130px",
                            "add": 1,
                            "edit": {
                                "type": "NumberSpinner",
                                "digits": 3
                            }
                        },
                        {
                            "caption": "Critical at",
                            "name": "CriticalAt",
                            "width": "130px",
                            "add": 2,
                            "edit": {
                                "type": "NumberSpinner",
                                "digits": 3
                            }
                        }
                    ],
                    "form": [
                        {
                            "type": "SelectVariable",
                            "name": "VariableID",
                            "caption": "Variable",
                            "validVariableTypes": [
                                0,
                                1,
                                2
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "Direction",
                            "caption": "Alarm direction",
                            "options": [
                                {
                                    "caption": "Higher is worse",
                                    "value": "high"
                                },
                                {
                                    "caption": "Lower is worse",
                                    "value": "low"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "WarningAt",
                            "caption": "Warning at",
                            "digits": 3
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "CriticalAt",
                            "caption": "Critical at",
                            "digits": 3
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "StatusRulesDiagnostics",
                    "caption": "",
                    "visible": false
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate Tree"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "TreeLayout",
                            "caption": "Tree layout",
                            "options": [
                                {
                                    "caption": "Orthogonal",
                                    "value": "orthogonal"
                                },
                                {
                                    "caption": "Radial",
                                    "value": "radial"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "Orientation",
                            "caption": "Direction",
                            "options": [
                                {
                                    "caption": "Left to right",
                                    "value": "LR"
                                },
                                {
                                    "caption": "Right to left",
                                    "value": "RL"
                                },
                                {
                                    "caption": "Top to bottom",
                                    "value": "TB"
                                },
                                {
                                    "caption": "Bottom to top",
                                    "value": "BT"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "EdgeShape",
                            "caption": "Connection lines",
                            "options": [
                                {
                                    "caption": "Curved",
                                    "value": "curve"
                                },
                                {
                                    "caption": "Polyline",
                                    "value": "polyline"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "InitialDepth",
                            "caption": "Initially expanded levels",
                            "minimum": 0,
                            "maximum": 6
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "NodeSize",
                            "caption": "Node size",
                            "minimum": 4,
                            "maximum": 30,
                            "suffix": "px"
                        },
                        {
                            "type": "CheckBox",
                            "name": "RoamEnabled",
                            "caption": "Pan and zoom"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowValues",
                            "caption": "Show variable values"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LabelFontSizePercent",
                            "caption": "Label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LabelColor",
                            "caption": "Label color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "CategoryColor",
                            "caption": "Category color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "InstanceColor",
                            "caption": "Instance color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "VariableColor",
                            "caption": "Variable color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "EdgeColor",
                            "caption": "Line color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "HealthyColor",
                            "caption": "Healthy color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (status)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "WarningColor",
                            "caption": "Warning color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (status)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "CriticalColor",
                            "caption": "Critical color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (status)"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Read current Tree data",
            "onClick": "echo ECTH_GetTreeData($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Tree is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Select a valid Tree root and limits"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Tree design is invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Tree objects could not be read"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Tree status rules are invalid"
        }
    ]
}
