                                {
                                    "caption": "Standard (ECharts)",
                                    "value": "standard"
                                },
                                {
                                    "caption": "Highlight bar",
                                    "value": "outline"
                                },
                                {
                                    "caption": "Focus bar and dim others",
                                    "value": "focus"
                                },
                                {
                                    "caption": "Off",
                                    "value": "off"
                                }
                            ]
                        },
                        {
                            "type": "SelectColor",
                            "name": "BarHighlightColor",
                            "caption": "Highlight color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "ValueAxisRangeMode",
                            "caption": "Value scale",
                            "onChange": "ECBP_UpdateValueScaleForm($id, $ValueAxisRangeMode);",
                            "options": [
                                {
                                    "caption": "Automatic",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Fixed range",
                                    "value": "manual"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ValueAxisMinimum",
                            "caption": "Scale minimum",
                            "digits": 3
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ValueAxisMaximum",
                            "caption": "Scale maximum",
                            "digits": 3
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Minimum and maximum apply to a fixed scale. Values outside the range are clipped."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowBarBackground",
                            "caption": "Show background tracks"
