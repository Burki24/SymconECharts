                        {
                            "type": "SelectColor",
                            "name": "BarBackgroundColor",
                            "caption": "Track color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BarBackgroundOpacityPercent",
                            "caption": "Track opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "The outer radius must exceed the inner radius by at least 20 percentage points."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "StartAngle",
                            "caption": "Start angle",
                            "minimum": 0,
                            "maximum": 360,
                            "suffix": "°"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AngularSpan",
                            "caption": "Angular span",
                            "minimum": 30,
                            "maximum": 360,
                            "suffix": "°"
                        },
                        {
                            "type": "CheckBox",
                            "name": "Clockwise",
                            "caption": "Clockwise"
                        },
                        {
                            "type": "CheckBox",
                            "name": "RoundCaps",
                            "caption": "Rounded caps"
                        }
                    ]
                }
            ]
