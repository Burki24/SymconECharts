{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "Polar sources",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "360px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "caption": "Category label (optional)",
                    "name": "Label",
                    "width": "180px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable presentation",
                    "name": "UseVariablePresentation",
                    "width": "150px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Unit",
                    "name": "Unit",
                    "width": "90px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Decimals",
                    "name": "Decimals",
                    "width": "90px",
                    "add": 1,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 0,
                        "maximum": 6
                    }
                },
                {
                    "caption": "Color",
                    "name": "Color",
                    "width": "130px",
                    "add": -1,
                    "edit": {
                        "type": "SelectColor",
                        "allowTransparent": true,
                        "transparentCaption": "Automatic (theme)"
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Category label (optional)"
                },
                {
                    "type": "CheckBox",
                    "name": "UseVariablePresentation",
                    "caption": "Variable presentation"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Unit",
                    "caption": "Unit"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Decimals",
                    "caption": "Decimals",
                    "minimum": 0,
                    "maximum": 6
                },
                {
                    "type": "SelectColor",
                    "name": "Color",
                    "caption": "Color",
                    "allowTransparent": true,
                    "transparentCaption": "Automatic (theme)"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Use 1 to 16 unique numeric variables with one unit. Each variable keeps its own identity even when labels match. Radial spokes and concentric arcs are available in both designers."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "width": "720px",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate bars",
                            "onChange": "ECBP_UpdateAnimationForm($id, false, $AnimationEnabled);"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "EChartsTheme",
                    "caption": "ECharts theme",
                    "options": [
                        {
                            "caption": "Automatic (Symcon design)",
                            "value": "auto"
                        },
                        {
                            "caption": "Dark",
                            "value": "dark"
                        },
                        {
                            "caption": "Vintage",
                            "value": "vintage"
                        },
                        {
                            "caption": "Macarons",
                            "value": "macarons"
                        },
                        {
                            "caption": "Infographic",
                            "value": "infographic"
                        },
                        {
                            "caption": "Shine",
                            "value": "shine"
                        },
                        {
                            "caption": "Roma",
                            "value": "roma"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "PolarMode",
                            "caption": "Polar layout",
                            "options": [
                                {
                                    "caption": "Radial spokes",
                                    "value": "radial"
                                },
                                {
                                    "caption": "Concentric arcs",
                                    "value": "tangential"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "SortOrder",
                            "caption": "Sort order",
                            "options": [
                                {
                                    "caption": "Configured order",
                                    "value": "configured"
                                },
                                {
                                    "caption": "Value ascending",
                                    "value": "ascending"
                                },
                                {
                                    "caption": "Value descending",
                                    "value": "descending"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowCategoryLabels",
                            "caption": "Show category labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowValues",
                            "caption": "Show values"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowGrid",
                            "caption": "Show grid"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "ValueLabelPosition",
                    "caption": "Value label position",
                    "options": [
                        {
                            "caption": "Center of bar",
                            "value": "middle"
                        },
                        {
                            "caption": "Inside at start",
                            "value": "insideStart"
                        },
                        {
                            "caption": "Inside at end",
                            "value": "insideEnd"
                        },
                        {
                            "caption": "Outside the bar",
                            "value": "outside"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "CategoryLabelFontSize",
                            "caption": "Category font size",
                            "minimum": 8,
                            "maximum": 24,
                            "suffix": "px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ValueLabelFontSize",
                            "caption": "Value font size",
                            "minimum": 8,
                            "maximum": 24,
                            "suffix": "px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ScaleLabelFontSize",
                            "caption": "Scale font size",
                            "minimum": 8,
                            "maximum": 24,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BarWidthPercent",
                            "caption": "Bar width",
                            "minimum": 20,
                            "maximum": 100,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "InnerRadiusPercent",
                            "caption": "Inner radius",
                            "minimum": 0,
                            "maximum": 75,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "OuterRadiusPercent",
                            "caption": "Outer radius",
                            "minimum": 20,
                            "maximum": 95,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "BarFillMode",
                            "caption": "Bar fill",
                            "onChange": "ECBP_UpdateBarFillForm($id, false, $BarFillMode);",
                            "options": [
                                {
                                    "caption": "Solid color",
                                    "value": "solid"
                                },
                                {
                                    "caption": "Gradient",
                                    "value": "gradient"
                                }
                            ]
                        },
                        {
                            "type": "SelectColor",
                            "name": "BarGradientColor",
                            "caption": "Gradient end color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BarOpacityPercent",
                            "caption": "Bar opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BarOutlineWidth",
                            "caption": "Bar outline (0 = off)",
                            "minimum": 0,
                            "maximum": 8,
                            "suffix": "px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "BarOutlineColor",
                            "caption": "Outline color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BarShadowBlur",
                            "caption": "Bar shadow (0 = off)",
                            "minimum": 0,
                            "maximum": 20,
                            "suffix": "px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "BarShadowColor",
                            "caption": "Shadow color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BarShadowOpacityPercent",
                            "caption": "Shadow opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        }
                    ]
                },
