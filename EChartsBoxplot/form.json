{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "Boxplot variables",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "320px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "caption": "Label (optional)",
                    "name": "Label",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Box color (optional)",
                    "name": "Color",
                    "width": "160px",
                    "add": -1,
                    "edit": {
                        "type": "SelectColor",
                        "allowTransparent": true
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Label (optional)"
                },
                {
                    "type": "SelectColor",
                    "name": "Color",
                    "caption": "Box color (optional)",
                    "allowTransparent": true,
                    "transparentCaption": "Automatic (theme)"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Choose 1 to 10 numeric standard archive variables with the same unit. Each box shows completed hourly means: minimum, Q1, median, Q3 and maximum. Missing hours remain missing; counters are not supported."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "Range",
                    "caption": "Time range",
                    "options": [
                        {
                            "caption": "Last 24 hours",
                            "value": "24h"
                        },
                        {
                            "caption": "Last 7 days",
                            "value": "7d"
                        },
                        {
                            "caption": "Last 30 days",
                            "value": "30d"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate Boxplot"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "Orientation",
                            "caption": "Orientation",
                            "options": [
                                {
                                    "caption": "Vertical",
                                    "value": "vertical"
                                },
                                {
                                    "caption": "Horizontal",
                                    "value": "horizontal"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowTooltip",
                            "caption": "Show tooltip"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BoxWidth",
                            "caption": "Maximum box width",
                            "minimum": 8,
                            "maximum": 80,
                            "suffix": "px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BorderWidth",
                            "caption": "Border width",
                            "minimum": 0,
                            "maximum": 8,
                            "suffix": "px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BoxOpacityPercent",
                            "caption": "Box opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        },
                        {
                            "type": "SelectColor",
                            "name": "BorderColor",
                            "caption": "Border color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowGrid",
                            "caption": "Show grid"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowAxisLabels",
                            "caption": "Show axis labels"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AxisFontSizePercent",
                            "caption": "Axis label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "AxisColor",
                            "caption": "Axis color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Boxplot is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Boxplot variables are invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Boxplot settings are invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Boxplot archive values could not be loaded"
        }
    ]
}
