{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "Sunburst variables",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Group",
                    "name": "Group",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Subgroup (optional)",
                    "name": "Subgroup",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "300px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "caption": "Label (optional)",
                    "name": "Label",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ],
            "form": [
                {
                    "type": "ValidationTextBox",
                    "name": "Group",
                    "caption": "Group"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Subgroup",
                    "caption": "Subgroup (optional)"
                },
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Label (optional)"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Use 1 to 100 unique numeric variables. Ring segments use their current non-negative values; zero values have no visible segment. Groups and optional subgroups are defined here."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate Sunburst"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowValues",
                            "caption": "Show values in segments"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowTooltip",
                            "caption": "Show tooltip"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LabelFontSizePercent",
                            "caption": "Value label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "LabelRotation",
                            "caption": "Label rotation",
                            "options": [
                                {
                                    "caption": "Radial",
                                    "value": "radial"
                                },
                                {
                                    "caption": "Tangential",
                                    "value": "tangential"
                                },
                                {
                                    "caption": "Horizontal",
                                    "value": "horizontal"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LabelMinAngle",
                            "caption": "Hide labels below angle",
                            "minimum": 0,
                            "maximum": 45,
                            "suffix": "°"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowInnerRingLabels",
                            "caption": "Inner ring labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowMiddleRingLabels",
                            "caption": "Middle ring labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowOuterRingLabels",
                            "caption": "Outer ring labels"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "InnerRingLabelFontSizePercent",
                            "caption": "Inner ring label size (0 = general)",
                            "minimum": 0,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "MiddleRingLabelFontSizePercent",
                            "caption": "Middle ring label size (0 = general)",
                            "minimum": 0,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "OuterRingLabelFontSizePercent",
                            "caption": "Outer ring label size (0 = general)",
                            "minimum": 0,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LabelColor",
                            "caption": "Value label color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "GroupColors",
                    "caption": "Fixed group colors (optional)",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        {
                            "caption": "Group",
                            "name": "Group",
                            "width": "240px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "Color",
                            "name": "Color",
                            "width": "180px",
                            "add": -1,
                            "edit": {
                                "type": "SelectColor",
                                "allowTransparent": true,
                                "transparentCaption": "Automatic (theme)"
                            }
                        }
                    ],
                    "form": [
                        {
                            "type": "ValidationTextBox",
                            "name": "Group",
                            "caption": "Group"
                        },
                        {
                            "type": "SelectColor",
                            "name": "Color",
                            "caption": "Color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "InnerRadiusPercent",
                            "caption": "Inner radius",
                            "minimum": 0,
                            "maximum": 50,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "OuterRadiusPercent",
                            "caption": "Outer radius",
                            "minimum": 50,
                            "maximum": 95,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "StartAngle",
                            "caption": "Start angle",
                            "minimum": 0,
                            "maximum": 360,
                            "suffix": "°"
                        },
                        {
                            "type": "CheckBox",
                            "name": "Clockwise",
                            "caption": "Clockwise"
                        },
                        {
                            "type": "Select",
                            "name": "SortMode",
                            "caption": "Segment order",
                            "options": [
                                {
                                    "caption": "Configured order",
                                    "value": "original"
                                },
                                {
                                    "caption": "Smallest first",
                                    "value": "asc"
                                },
                                {
                                    "caption": "Largest first",
                                    "value": "desc"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BorderWidth",
                            "caption": "Segment border",
                            "minimum": 0,
                            "maximum": 12,
                            "suffix": "px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "BorderColor",
                            "caption": "Segment border color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (background)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BorderRadius",
                            "caption": "Rounded segment corners",
                            "minimum": 0,
                            "maximum": 20,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ClickToRoot",
                            "caption": "Drill down on segment click"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Sunburst is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Sunburst variables or groups are invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Sunburst design is invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Sunburst values could not be loaded"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Sunburst values must be non-negative"
        }
    ]
}