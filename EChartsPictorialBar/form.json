{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "PictorialBar variables",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "320px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "caption": "Label (optional)",
                    "name": "Label",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Category color (optional)",
                    "name": "Color",
                    "width": "160px",
                    "add": -1,
                    "edit": {
                        "type": "SelectColor",
                        "allowTransparent": true
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Label (optional)"
                },
                {
                    "type": "SelectColor",
                    "name": "Color",
                    "caption": "Category color (optional)",
                    "allowTransparent": true,
                    "transparentCaption": "Automatic (theme)"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Choose 1 to 100 numeric variables with the same unit and non-negative current values. Symbols show proportions, not one unit each."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate PictorialBar"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "Orientation",
                            "caption": "Orientation",
                            "options": [
                                {
                                    "caption": "Vertical",
                                    "value": "vertical"
                                },
                                {
                                    "caption": "Horizontal",
                                    "value": "horizontal"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "SortOrder",
                            "caption": "Category order",
                            "options": [
                                {
                                    "caption": "List order",
                                    "value": "configured"
                                },
                                {
                                    "caption": "Ascending values",
                                    "value": "ascending"
                                },
                                {
                                    "caption": "Descending values",
                                    "value": "descending"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "Symbol",
                            "caption": "Symbol shape",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Rectangle",
                                    "value": "rect"
                                },
                                {
                                    "caption": "Rounded rectangle",
                                    "value": "roundRect"
                                },
                                {
                                    "caption": "Circle",
                                    "value": "circle"
                                },
                                {
                                    "caption": "Diamond",
                                    "value": "diamond"
                                },
                                {
                                    "caption": "Triangle",
                                    "value": "triangle"
                                },
                                {
                                    "caption": "Symcon icon",
                                    "value": "icon"
                                },
                                {
                                    "caption": "Custom SVG shape",
                                    "value": "svg"
                                }
                            ]
                        },
                        {
                            "type": "SelectIcon",
                            "name": "SymbolIcon",
                            "caption": "Symcon icon",
                            "width": "225px"
                        },
                        {
                            "type": "CheckBox",
                            "name": "SymbolRepeat",
                            "caption": "Repeat symbols"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectFile",
                            "name": "CustomSymbolSVG",
                            "caption": "Custom SVG shape",
                            "extensions": ".svg",
                            "width": "300px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Label",
                            "width": "100%",
                            "caption": "Path-only SVG with viewBox; colors come from the designer. Convert text and basic shapes to paths first."
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "SymbolSize",
                            "caption": "Repeated symbol size",
                            "minimum": 4,
                            "maximum": 40,
                            "suffix": "px",
                            "width": "200px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "SymbolGap",
                            "caption": "Symbol gap",
                            "minimum": 0,
                            "maximum": 20,
                            "suffix": "px",
                            "width": "200px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BarWidth",
                            "caption": "Maximum bar width",
                            "minimum": 4,
                            "maximum": 80,
                            "suffix": "px",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ScaleMaximum",
                            "caption": "Scale maximum (0 = automatic)",
                            "minimum": 0,
                            "maximum": 1000000000,
                            "suffix": "",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowGrid",
                            "caption": "Show grid"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show category labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowValues",
                            "caption": "Show values"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowTooltip",
                            "caption": "Show tooltip"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%",
                            "width": "200px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AxisFontSizePercent",
                            "caption": "Axis label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%",
                            "width": "200px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ValueFontSizePercent",
                            "caption": "Value label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)",
                            "width": "225px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "AxisColor",
                            "caption": "Axis color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)",
                            "width": "225px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "ValueColor",
                            "caption": "Value label color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)",
                            "width": "225px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "GridColor",
                            "caption": "Grid color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)",
                            "width": "225px"
                        },
                        {
                            "type": "CheckBox",
                            "name": "TitleBold",
                            "caption": "Bold title"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BorderWidth",
                            "caption": "Border width",
                            "minimum": 0,
                            "maximum": 5,
                            "suffix": "px",
                            "width": "200px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "BorderColor",
                            "caption": "Border color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)",
                            "width": "225px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "OpacityPercent",
                            "caption": "Opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "BorderType",
                            "caption": "Border style",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Solid",
                                    "value": "solid"
                                },
                                {
                                    "caption": "Dashed",
                                    "value": "dashed"
                                },
                                {
                                    "caption": "Dotted",
                                    "value": "dotted"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "FontFamily",
                            "caption": "Font family",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Arial",
                                    "value": "Arial, sans-serif"
                                },
                                {
                                    "caption": "Verdana",
                                    "value": "Verdana, sans-serif"
                                },
                                {
                                    "caption": "Georgia",
                                    "value": "Georgia, serif"
                                },
                                {
                                    "caption": "Monospace",
                                    "value": "monospace"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "ValuePosition",
                            "caption": "Value position",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Outside",
                                    "value": "outside"
                                },
                                {
                                    "caption": "Inside center",
                                    "value": "inside"
                                },
                                {
                                    "caption": "Inside start",
                                    "value": "insideStart"
                                },
                                {
                                    "caption": "Inside end",
                                    "value": "insideEnd"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ValueDistance",
                            "caption": "Value label distance",
                            "minimum": 0,
                            "maximum": 30,
                            "suffix": "px",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ValueBold",
                            "caption": "Bold values"
                        },
                        {
                            "type": "CheckBox",
                            "name": "HideOverlap",
                            "caption": "Hide overlapping values"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "CategoryLabelRotate",
                            "caption": "Category label rotation",
                            "minimum": -90,
                            "maximum": 90,
                            "suffix": "°",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowAxisValues",
                            "caption": "Show axis values"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowAxisTicks",
                            "caption": "Show axis ticks"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "GridWidth",
                            "caption": "Grid line width",
                            "minimum": 0,
                            "maximum": 5,
                            "suffix": "px",
                            "width": "200px"
                        },
                        {
                            "type": "Select",
                            "name": "GridType",
                            "caption": "Grid line style",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Solid",
                                    "value": "solid"
                                },
                                {
                                    "caption": "Dashed",
                                    "value": "dashed"
                                },
                                {
                                    "caption": "Dotted",
                                    "value": "dotted"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "GridOpacityPercent",
                            "caption": "Grid opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "ColorMode",
                            "caption": "Symbol coloring",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Category colors",
                                    "value": "category"
                                },
                                {
                                    "caption": "Continuous color by value",
                                    "value": "value"
                                },
                                {
                                    "caption": "Gradient along the scale",
                                    "value": "gradient"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ColorMinimum",
                            "caption": "Color range minimum",
                            "digits": 6,
                            "minimum": 0,
                            "maximum": 1000000000000,
                            "suffix": "",
                            "width": "200px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ColorMaximum",
                            "caption": "Color range maximum",
                            "digits": 6,
                            "minimum": 0,
                            "maximum": 1000000000000,
                            "suffix": "",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "LowColor",
                            "caption": "Low value color",
                            "allowTransparent": false
                        },
                        {
                            "type": "SelectColor",
                            "name": "MiddleColor",
                            "caption": "Middle value color",
                            "allowTransparent": false
                        },
                        {
                            "type": "SelectColor",
                            "name": "HighColor",
                            "caption": "High value color",
                            "allowTransparent": false
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ShadowBlur",
                            "caption": "Shadow blur",
                            "minimum": 0,
                            "maximum": 20,
                            "suffix": "px",
                            "width": "200px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "ShadowColor",
                            "caption": "Shadow color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ShadowOffsetX",
                            "caption": "Horizontal shadow offset",
                            "minimum": -20,
                            "maximum": 20,
                            "suffix": "px",
                            "width": "200px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ShadowOffsetY",
                            "caption": "Vertical shadow offset",
                            "minimum": -20,
                            "maximum": 20,
                            "suffix": "px",
                            "width": "200px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "EmphasisDisabled",
                            "caption": "Disable highlighting"
                        },
                        {
                            "type": "Select",
                            "name": "Focus",
                            "caption": "Hover focus",
                            "width": "225px",
                            "options": [
                                {
                                    "caption": "Hovered category",
                                    "value": "self"
                                },
                                {
                                    "caption": "None",
                                    "value": "none"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BlurOpacityPercent",
                            "caption": "Unfocused opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%",
                            "width": "200px"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "PictorialBar is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "PictorialBar variables are invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "PictorialBar settings are invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "PictorialBar values could not be loaded"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "PictorialBar requires non-negative values."
        }
    ]
}
