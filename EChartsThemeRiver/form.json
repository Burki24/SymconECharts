                        {
                            "type": "CheckBox",
                            "name": "LegendItalic",
                            "caption": "Italic legend"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
