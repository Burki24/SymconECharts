{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "Select",
            "name": "Metric",
            "caption": "Data basis",
            "options": [
                {
                    "caption": "Interval mean (standard archive)",
                    "value": "average"
                },
                {
                    "caption": "Counter consumption per interval",
                    "value": "consumption"
                }
            ]
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "ThemeRiver sources",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Initially visible",
                    "name": "InitiallyVisible",
                    "width": "120px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "320px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "caption": "Label (optional)",
                    "name": "Label",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Band color (optional)",
                    "name": "Color",
                    "width": "160px",
                    "add": -1,
                    "edit": {
                        "type": "SelectColor",
                        "allowTransparent": true
                    }
                }
            ],
            "form": [
                {
                    "type": "CheckBox",
                    "name": "InitiallyVisible",
                    "caption": "Initially visible"
                },
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Label (optional)"
                },
                {
                    "type": "SelectColor",
                    "name": "Color",
                    "caption": "Band color (optional)",
                    "allowTransparent": true,
                    "transparentCaption": "Automatic (theme)"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Choose 1 to 16 archive variables of the same unit. Means require standard archives; consumption requires counter archives. Only nonnegative completed interval values are supported. Intervals missing on any source remain blank."
        },
        {
            "type": "CheckBox",
            "name": "EnableBandSelection",
            "caption": "Enable band selection"
        },
        {
            "type": "Label",
            "caption": "Initial visibility applies only when band selection is enabled. Hidden sources remain in the shared 16000-aggregate load budget and common gap checks."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "Range",
                    "caption": "Time range",
                    "onChange": "ECRV_UpdateTimeRangeForm($id, $Range);",
                    "options": [
                        {
                            "caption": "Last 24 hours",
                            "value": "24h"
                        },
                        {
                            "caption": "Last 7 days",
                            "value": "7d"
                        },
                        {
                            "caption": "Last 30 days",
                            "value": "30d"
                        },
                        {
                            "caption": "Custom duration",
                            "value": "custom"
                        },
                        {
                            "caption": "Fixed historical period",
                            "value": "absolute"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "Aggregation",
                    "caption": "Interval",
                    "options": [
                        {
                            "caption": "Hourly",
                            "value": "hour"
                        },
                        {
                            "caption": "Daily",
                            "value": "day"
                        }
                    ]
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "CustomRangeValue",
                    "caption": "Duration",
                    "width": "140px",
                    "minimum": 1,
                    "maximum": 1000,
                    "visible": false
                },
                {
                    "type": "Select",
                    "name": "CustomRangeUnit",
                    "caption": "Duration unit",
                    "width": "140px",
                    "visible": false,
                    "options": [
                        {
                            "caption": "Minutes",
                            "value": "minute"
                        },
                        {
                            "caption": "Hours",
                            "value": "hour"
                        },
                        {
                            "caption": "Days",
                            "value": "day"
                        },
                        {
                            "caption": "Weeks",
                            "value": "week"
                        }
                    ]
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Custom durations end at the last completed interval. Only whole intervals are included, up to 720. Short durations may contain none."
        },
        {
            "type": "SelectDateTime",
            "name": "AbsoluteStart",
            "caption": "From (inclusive)",
            "visible": false
        },
        {
            "type": "SelectDateTime",
            "name": "AbsoluteEnd",
            "caption": "Until (exclusive)",
            "visible": false
        },
        {
            "type": "Label",
            "name": "AbsoluteRangeHint",
            "caption": "Start is included, end is excluded. Only fully contained completed intervals are evaluated. The end must not be in the future.",
            "visible": false
        },
        {
            "type": "Label",
            "name": "AbsoluteTimeZone",
            "caption": "Dates use the Symcon time zone.",
            "visible": false
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate ThemeRiver"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowTooltip",
                            "caption": "Show tooltip"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowLegend",
                            "caption": "Show legend"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show band labels"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BandOpacityPercent",
                            "caption": "Band opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BorderWidth",
                            "caption": "Band border width",
                            "minimum": 0,
                            "maximum": 5,
                            "suffix": "px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "BorderColor",
                            "caption": "Band border color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "BandHeightPercent",
                            "caption": "Band height",
                            "minimum": 20,
                            "maximum": 100,
                            "suffix": "%"
                        },
                        {
                            "type": "Select",
                            "name": "BorderType",
                            "caption": "Band border type",
                            "options": [
                                {
                                    "caption": "Solid",
                                    "value": "solid"
                                },
                                {
                                    "caption": "Dashed",
                                    "value": "dashed"
                                },
                                {
                                    "caption": "Dotted",
                                    "value": "dotted"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ShadowBlur",
                            "caption": "Shadow blur",
                            "minimum": 0,
                            "maximum": 20,
                            "suffix": "px"
                        },
                        {
                            "type": "SelectColor",
                            "name": "ShadowColor",
                            "caption": "Shadow color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ShadowOffsetX",
                            "caption": "Horizontal shadow offset",
                            "minimum": -20,
                            "maximum": 20,
                            "suffix": "px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ShadowOffsetY",
                            "caption": "Vertical shadow offset",
                            "minimum": -20,
                            "maximum": 20,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "EmphasisEnabled",
                            "caption": "Highlight on hover"
                        },
                        {
                            "type": "Select",
                            "name": "EmphasisFocus",
                            "caption": "Hover focus",
                            "options": [
                                {
                                    "caption": "Hovered band",
                                    "value": "self"
                                },
                                {
                                    "caption": "Hovered section",
                                    "value": "series"
                                },
                                {
                                    "caption": "No dimming",
                                    "value": "none"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BlurOpacityPercent",
                            "caption": "Other bands opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowAxisLabels",
                            "caption": "Show time labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowAxisTicks",
                            "caption": "Show axis ticks"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowAxisLine",
                            "caption": "Show axis line"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AxisLineWidth",
                            "caption": "Axis line width",
                            "minimum": 0,
                            "maximum": 5,
                            "suffix": "px"
                        },
                        {
                            "type": "Select",
                            "name": "AxisLineType",
                            "caption": "Axis line type",
                            "options": [
                                {
                                    "caption": "Solid",
                                    "value": "solid"
                                },
                                {
                                    "caption": "Dashed",
                                    "value": "dashed"
                                },
                                {
                                    "caption": "Dotted",
                                    "value": "dotted"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "TimeLabelFormat",
                            "caption": "Time label format",
                            "options": [
                                {
                                    "caption": "Automatic",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Date",
                                    "value": "date"
                                },
                                {
                                    "caption": "Date and time",
                                    "value": "dateTime"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AxisLabelMargin",
                            "caption": "Time label distance",
                            "minimum": 0,
                            "maximum": 30,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowGrid",
                            "caption": "Show grid lines"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "GridLineWidth",
                            "caption": "Grid line width",
                            "minimum": 0,
                            "maximum": 5,
                            "suffix": "px"
                        },
                        {
                            "type": "Select",
                            "name": "GridLineType",
                            "caption": "Grid line type",
                            "options": [
                                {
                                    "caption": "Solid",
                                    "value": "solid"
                                },
                                {
                                    "caption": "Dashed",
                                    "value": "dashed"
                                },
                                {
                                    "caption": "Dotted",
                                    "value": "dotted"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "GridColor",
                            "caption": "Grid color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "GridOpacityPercent",
                            "caption": "Grid opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "LegendPosition",
                            "caption": "Legend position",
                            "options": [
                                {
                                    "caption": "Bottom",
                                    "value": "bottom"
                                },
                                {
                                    "caption": "Top",
                                    "value": "top"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "LegendAlignment",
                            "caption": "Legend alignment",
                            "options": [
                                {
                                    "caption": "Left",
                                    "value": "left"
                                },
                                {
                                    "caption": "Center",
                                    "value": "center"
                                },
                                {
                                    "caption": "Right",
                                    "value": "right"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "LegendIcon",
