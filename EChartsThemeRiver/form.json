                            "options": [
                                {
                                    "caption": "Rounded rectangle",
                                    "value": "roundRect"
                                },
                                {
                                    "caption": "Rectangle",
                                    "value": "rect"
                                },
                                {
                                    "caption": "Circle",
                                    "value": "circle"
                                },
                                {
                                    "caption": "Diamond",
                                    "value": "diamond"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LegendItemWidth",
                            "caption": "Legend symbol width",
                            "minimum": 6,
                            "maximum": 40,
                            "suffix": "px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LegendItemHeight",
                            "caption": "Legend symbol height",
                            "minimum": 6,
                            "maximum": 30,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "LegendItemGap",
                            "caption": "Legend item distance",
                            "minimum": 0,
                            "maximum": 30,
                            "suffix": "px"
                        }
                    ]
                },
