{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Nodes",
            "caption": "Graph nodes",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Symcon object",
                    "name": "ObjectID",
                    "width": "300px",
                    "add": 0,
                    "edit": {
                        "type": "SelectObject"
                    }
                },
                {
                    "caption": "Label (optional)",
                    "name": "Label",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectObject",
                    "name": "ObjectID",
                    "caption": "Symcon object"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Label (optional)"
                }
            ]
        },
        {
            "type": "List",
            "name": "Edges",
            "caption": "Connections",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "From",
                    "name": "SourceObjectID",
                    "width": "300px",
                    "add": 0,
                    "edit": {
                        "type": "SelectObject"
                    }
                },
                {
                    "caption": "To",
                    "name": "TargetObjectID",
                    "width": "300px",
                    "add": 0,
                    "edit": {
                        "type": "SelectObject"
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectObject",
                    "name": "SourceObjectID",
                    "caption": "From"
                },
                {
                    "type": "SelectObject",
                    "name": "TargetObjectID",
                    "caption": "To"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Select 2–80 categories, instances or variables and connect them with 1–200 undirected edges. Both endpoints must be selected nodes. Duplicate and self connections are invalid."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate Graph"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "GraphLayout",
                            "caption": "Graph layout",
                            "options": [
                                {
                                    "caption": "Force-directed",
                                    "value": "force"
                                },
                                {
                                    "caption": "Circular",
                                    "value": "circular"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "NodeSize",
                            "caption": "Node size",
                            "minimum": 6,
                            "maximum": 40,
                            "suffix": "px"
                        },
                        {
                            "type": "CheckBox",
                            "name": "RoamEnabled",
                            "caption": "Pan and zoom"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowValues",
                            "caption": "Show variable values"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LabelFontSizePercent",
                            "caption": "Label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LabelColor",
                            "caption": "Label color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "NodeColor",
                            "caption": "Node color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "EdgeColor",
                            "caption": "Connection color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Read current Graph data",
            "onClick": "echo ECGR_GetGraphData($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Graph is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Graph nodes or connections are invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Graph design is invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Graph objects could not be read"
        }
    ]
}