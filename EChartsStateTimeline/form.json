{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "StateTimeline sources",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "320px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            0,
                            1
                        ]
                    }
                },
                {
                    "caption": "Label (optional)",
                    "name": "Label",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "States",
                    "visible": false,
                    "add": [],
                    "save": true,
                    "edit": {
                        "type": "List"
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Variable",
                    "validVariableTypes": [
                        0,
                        1
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Label (optional)"
                },
                {
                    "type": "Label",
                    "caption": "Boolean values use 0 and 1. Unassigned states are shown as numbers."
                },
                {
                    "type": "List",
                    "name": "States",
                    "caption": "State definitions",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Value",
                            "name": "Value",
                            "width": "120px",
                            "add": 0,
                            "edit": {
                                "type": "NumberSpinner",
                                "digits": 0
                            }
                        },
                        {
                            "caption": "State label",
                            "name": "Label",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "State color",
                            "name": "Color",
                            "width": "160px",
                            "add": -1,
                            "edit": {
                                "type": "SelectColor",
                                "allowTransparent": true,
                                "transparentCaption": "Automatic (theme)"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Choose 1 to 8 Boolean or Integer standard archive variables. States are read without aggregation. Missing initial states remain unknown."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "Range",
                    "caption": "Time range",
                    "options": [
                        {
                            "caption": "Last 24 hours",
                            "value": "24h"
                        },
                        {
                            "caption": "Last 7 days",
                            "value": "7d"
                        },
                        {
                            "caption": "Last 30 days",
                            "value": "30d"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate state intervals"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "EnableZoom",
                            "caption": "Enable zoom"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowTooltip",
                            "caption": "Show tooltip"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show state labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowGrid",
                            "caption": "Show grid"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "RowHeightPercent",
                            "caption": "Interval height",
                            "minimum": 20,
                            "maximum": 100,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BarOpacityPercent",
                            "caption": "Interval opacity",
                            "minimum": 0,
                            "maximum": 100,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "BorderWidth",
                            "caption": "Border width",
                            "minimum": 0,
                            "maximum": 5,
                            "suffix": "px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title font size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AxisFontSizePercent",
                            "caption": "Axis font size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LabelFontSizePercent",
                            "caption": "State label font size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "AxisColor",
                            "caption": "Axis color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LabelColor",
                            "caption": "State label color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "BorderColor",
                            "caption": "Border color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "UnknownColor",
                            "caption": "Unknown state color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "StateTimeline is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "StateTimeline variables are invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "StateTimeline settings are invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "StateTimeline archive values could not be loaded"
        }
    ]
}
