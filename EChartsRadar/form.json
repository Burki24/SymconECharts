{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Axes",
            "caption": "Radar axes",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "name": "Key",
                    "caption": "Axis key",
                    "width": "180px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "Label",
                    "caption": "Axis label",
                    "width": "180px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "Minimum",
                    "caption": "Minimum",
                    "width": "180px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 3
                    }
                },
                {
                    "name": "Maximum",
                    "caption": "Maximum",
                    "width": "180px",
                    "add": 100,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 3
                    }
                },
                {
                    "name": "Unit",
                    "caption": "Unit",
                    "width": "180px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "Decimals",
                    "caption": "Decimals",
                    "width": "180px",
                    "add": 1,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 0,
                        "maximum": 6
                    }
                }
            ],
            "form": [
                {
                    "type": "ValidationTextBox",
                    "name": "Key",
                    "caption": "Axis key"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Axis label"
                },
                {
                    "type": "NumberSpinner",
                    "digits": 3,
                    "name": "Minimum",
                    "caption": "Minimum"
                },
                {
                    "type": "NumberSpinner",
                    "digits": 3,
                    "name": "Maximum",
                    "caption": "Maximum"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Unit",
                    "caption": "Unit"
                },
                {
                    "type": "NumberSpinner",
                    "minimum": 0,
                    "maximum": 6,
                    "name": "Decimals",
                    "caption": "Decimals"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Configure 3 to 10 axes with unique keys, explicit ranges and optional units. The radius represents the percentage of each axis range, not a quality score."
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "Comparison values",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "name": "Group",
                    "caption": "Comparison group",
                    "width": "180px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "Axis",
                    "caption": "Axis",
                    "width": "180px",
                    "add": "",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Select axis",
                                "value": ""
                            }
                        ]
                    }
                },
                {
                    "name": "VariableID",
                    "caption": "Current variable",
                    "width": "180px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                }
            ],
            "form": [
                {
                    "type": "ValidationTextBox",
                    "name": "Group",
                    "caption": "Comparison group"
                },
                {
                    "type": "Select",
                    "options": [
                        {
                            "caption": "Select axis",
                            "value": ""
