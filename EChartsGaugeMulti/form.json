{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. When adding further charts, select the existing gateway instead of creating another one."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "Label",
            "caption": "Configure 2 to 16 unique numeric sources. Their order determines their position in the selected Gauge template."
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "Gauge sources",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "250px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "caption": "Label",
                    "name": "Label",
                    "width": "auto",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Use variable presentation",
                    "name": "UseVariablePresentation",
                    "width": "160px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Minimum",
                    "name": "Minimum",
                    "width": "100px",
                    "add": 0.0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 3
                    }
                },
                {
                    "caption": "Maximum",
                    "name": "Maximum",
                    "width": "100px",
                    "add": 100.0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 3
                    }
                },
                {
                    "caption": "Unit",
                    "name": "Unit",
                    "width": "90px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Decimal places",
                    "name": "Decimals",
                    "width": "120px",
                    "add": 1,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 0,
                        "maximum": 6
                    }
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "width": "700px",
            "items": [
                {
                    "type": "Label",
                    "caption": "Choose independent dials, ring Gauges, concentric rings, or a weather-station instrument panel. Source order determines placement; every source keeps its own range and unit."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "GaugePreset",
                            "caption": "Gauge preset",
                            "width": "260px",
                            "options": [
                                {
                                    "caption": "Multi Title",
                                    "value": "multi-title"
                                },
                                {
                                    "caption": "Ring grid",
                                    "value": "ring-grid"
                                },
                                {
                                    "caption": "Concentric rings",
                                    "value": "ring-concentric"
                                },
                                {
                                    "caption": "Weather station",
                                    "value": "weather-station"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "width": "260px",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Fine tuning values range from 50% to 150%. 100% restores the preset default."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "RingWidthPercent",
                            "caption": "Ring width",
                            "minimum": 50,
                            "maximum": 150,
                            "suffix": "%",
                            "width": "260px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ScaleFontSizePercent",
                            "caption": "Scale font size",
                            "minimum": 50,
                            "maximum": 150,
                            "suffix": "%",
                            "width": "260px"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ValueFontSizePercent",
                            "caption": "Value font size",
                            "minimum": 50,
                            "maximum": 150,
                            "suffix": "%",
                            "width": "260px"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title font size",
                            "minimum": 50,
                            "maximum": 150,
                            "suffix": "%",
                            "width": "260px"
                        }
                    ]
                },
                {
                    "type": "Image",
                    "name": "GaugePreview",
                    "image": "",
                    "center": true,
                    "width": "100%"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Read current Gauge Multi data",
            "onClick": "echo ECGM_GetGaugeData($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Gauge Multi is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Configure 2 to 16 unique numeric sources"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "One or more Gauge ranges are invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "EChartsGateway request failed"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Multi Gauge design is invalid"
        }
    ]
}
