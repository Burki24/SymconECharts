{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. When adding further charts, select the existing gateway instead of creating another one."
        },
        {
            "type": "SelectVariable",
            "name": "SourceVariableID",
            "caption": "Source variable",
            "validVariableTypes": [
                1,
                2
            ],
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
        },
        {
            "type": "NumberSpinner",
            "name": "Minimum",
            "caption": "Minimum",
            "digits": 3,
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
        },
        {
            "type": "NumberSpinner",
            "name": "Maximum",
            "caption": "Maximum",
            "digits": 3,
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title",
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
        },
        {
            "type": "ValidationTextBox",
            "name": "Unit",
            "caption": "Unit",
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
        },
        {
            "type": "NumberSpinner",
            "name": "Decimals",
            "caption": "Decimal places",
            "minimum": 0,
            "maximum": 6,
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": true,
            "width": "700px",
            "items": [
                {
                    "type": "Label",
                    "caption": "Choose the Gauge layout and its independent ECharts theme. Automatic follows the Symcon design."
                },
                {
                    "type": "Select",
                    "name": "GaugePreset",
                    "caption": "Gauge preset",
                    "width": "300px",
                    "options": [
                        {
                            "caption": "Basic Gauge",
                            "value": "basic"
                        },
                        {
                            "caption": "Simple Gauge",
                            "value": "simple"
                        },
                        {
                            "caption": "Progress Gauge",
                            "value": "progress"
                        },
                        {
                            "caption": "Speed Gauge",
                            "value": "speed"
                        }
                    ],
                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                },
                {
                    "type": "Select",
                    "name": "EChartsTheme",
                    "caption": "ECharts theme",
                    "width": "300px",
                    "options": [
                        {
                            "caption": "Automatic (Symcon design)",
                            "value": "auto"
                        },
                        {
                            "caption": "Dark",
                            "value": "dark"
                        },
                        {
                            "caption": "Vintage",
                            "value": "vintage"
                        },
                        {
                            "caption": "Macarons",
                            "value": "macarons"
                        },
                        {
                            "caption": "Infographic",
                            "value": "infographic"
                        },
                        {
                            "caption": "Shine",
                            "value": "shine"
                        },
                        {
                            "caption": "Roma",
                            "value": "roma"
                        }
                    ],
                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Fine tuning",
                    "expanded": false,
                    "items": [
                        {
                            "type": "Label",
                            "caption": "All values range from 50% to 150% of the selected preset. 100% restores the preset default."
                        },
                        {
                            "type": "RowLayout",
                            "items": [
                                {
                                    "type": "NumberSpinner",
                                    "name": "ScaleFontSizePercent",
                                    "caption": "Scale font size",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                },
                                {
                                    "type": "NumberSpinner",
                                    "name": "ValueFontSizePercent",
                                    "caption": "Value font size",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                }
                            ]
                        },
                        {
                            "type": "RowLayout",
                            "items": [
                                {
                                    "type": "NumberSpinner",
                                    "name": "UnitFontSizePercent",
                                    "caption": "Unit font size",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                },
                                {
                                    "type": "NumberSpinner",
                                    "name": "TitleFontSizePercent",
                                    "caption": "Title font size",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                }
                            ]
                        },
                        {
                            "type": "RowLayout",
                            "items": [
                                {
                                    "type": "NumberSpinner",
                                    "name": "RingWidthPercent",
                                    "caption": "Ring width",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                },
                                {
                                    "type": "NumberSpinner",
                                    "name": "PointerWidthPercent",
                                    "caption": "Pointer width",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                }
                            ]
                        },
                        {
                            "type": "RowLayout",
                            "items": [
                                {
                                    "type": "NumberSpinner",
                                    "name": "MinorTickLengthPercent",
                                    "caption": "Minor tick length",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                },
                                {
                                    "type": "NumberSpinner",
                                    "name": "MajorTickLengthPercent",
                                    "caption": "Major tick length",
                                    "minimum": 50,
                                    "maximum": 150,
                                    "suffix": "%",
                                    "width": "260px",
                                    "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals, $GaugePreset, $EChartsTheme, $ScaleFontSizePercent, $ValueFontSizePercent, $UnitFontSizePercent, $TitleFontSizePercent, $RingWidthPercent, $PointerWidthPercent, $MinorTickLengthPercent, $MajorTickLengthPercent);"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Image",
                    "name": "GaugePreview",
                    "image": "",
                    "center": true,
                    "width": "100%"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Read current Gauge Single data",
            "onClick": "echo ECGS_GetGaugeData($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Gauge Single is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Select a numeric source variable"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Gauge range is invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "EChartsGateway request failed"
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Gauge design is invalid"
        },
        {
            "code": 206,
            "icon": "error",
            "caption": "ECharts theme is invalid"
        }
    ]
}
