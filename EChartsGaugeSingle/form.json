{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. When adding further charts, select the existing gateway instead of creating another one."
        },
        {
            "type": "SelectVariable",
            "name": "SourceVariableID",
            "caption": "Source variable",
            "validVariableTypes": [
                1,
                2
            ],
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals);"
        },
        {
            "type": "NumberSpinner",
            "name": "Minimum",
            "caption": "Minimum",
            "digits": 3,
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals);"
        },
        {
            "type": "NumberSpinner",
            "name": "Maximum",
            "caption": "Maximum",
            "digits": 3,
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals);"
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title",
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals);"
        },
        {
            "type": "ValidationTextBox",
            "name": "Unit",
            "caption": "Unit",
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals);"
        },
        {
            "type": "NumberSpinner",
            "name": "Decimals",
            "caption": "Decimal places",
            "minimum": 0,
            "maximum": 6,
            "onChange": "ECGS_UpdateGaugePreview($id, $SourceVariableID, $Minimum, $Maximum, $Title, $Unit, $Decimals);"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Preview",
            "expanded": true,
            "width": "700px",
            "items": [
                {
                    "type": "Image",
                    "name": "GaugePreview",
                    "image": "",
                    "center": true,
                    "width": "100%"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Read current Gauge Single data",
            "onClick": "echo ECGS_GetGaugeData($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Gauge Single is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Select a numeric source variable"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Gauge range is invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "EChartsGateway request failed"
        }
    ]
}
