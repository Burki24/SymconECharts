{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "SelectObject",
            "name": "NetworkMapInstanceID",
            "caption": "Zigbee2MQTT Network Map instance"
        },
        {
            "type": "Select",
            "name": "LinkSelection",
            "caption": "Link selection",
            "onChange": "ECGZ_UpdateLinkSelectionForm($id, $LinkSelection);",
            "options": [
                {
                    "caption": "Strongest links first",
                    "value": "strongest"
                },
                {
                    "caption": "Weakest links first",
                    "value": "weakest"
                },
                {
                    "caption": "LQI range",
                    "value": "range"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "MinimumLQI",
                    "caption": "Minimum LQI",
                    "minimum": 0,
                    "maximum": 255
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaximumLQI",
                    "caption": "Maximum LQI",
                    "visible": false,
                    "minimum": 0,
                    "maximum": 255
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaximumLinks",
                    "caption": "Maximum displayed links",
                    "minimum": 1,
                    "maximum": 2000
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Minimum LQI applies in every mode. Range endpoints are inclusive; the strongest matching links are shown first."
        },
        {
            "type": "Label",
            "caption": "Export the Network Map in Zigbee2MQTT first. This graph reads the latest JSON export without starting a scan. After each scan, export again before refreshing this graph."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile designer",
            "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "AnimationEnabled",
                            "caption": "Animate Graph"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDuration",
                            "caption": "Initial animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "AnimationDurationUpdate",
                            "caption": "Update animation",
                            "minimum": 0,
                            "maximum": 3000,
                            "suffix": "ms"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "EChartsTheme",
                            "caption": "ECharts theme",
                            "options": [
                                {
                                    "caption": "Automatic (Symcon design)",
                                    "value": "auto"
                                },
                                {
                                    "caption": "Dark",
                                    "value": "dark"
                                },
                                {
                                    "caption": "Vintage",
                                    "value": "vintage"
                                },
                                {
                                    "caption": "Macarons",
                                    "value": "macarons"
                                },
                                {
                                    "caption": "Infographic",
                                    "value": "infographic"
                                },
                                {
                                    "caption": "Shine",
                                    "value": "shine"
                                },
                                {
                                    "caption": "Roma",
                                    "value": "roma"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Select",
                            "name": "GraphLayout",
                            "caption": "Graph layout",
                            "options": [
                                {
                                    "caption": "Force-directed",
                                    "value": "force"
                                },
                                {
                                    "caption": "Circular",
                                    "value": "circular"
                                }
                            ]
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "NodeSize",
                            "caption": "Node size",
                            "minimum": 6,
                            "maximum": 40,
                            "suffix": "px"
                        },
                        {
                            "type": "CheckBox",
                            "name": "RoamEnabled",
                            "caption": "Pan and zoom"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "ShowLabels",
                            "caption": "Show labels"
                        },
                        {
                            "type": "CheckBox",
                            "name": "ShowLinkArrows",
                            "caption": "Show link direction"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "TitleFontSizePercent",
                            "caption": "Title size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "LabelFontSizePercent",
                            "caption": "Label size",
                            "minimum": 50,
                            "maximum": 200,
                            "suffix": "%"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "TitleColor",
                            "caption": "Title color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LabelColor",
                            "caption": "Label color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "NodeColor",
                            "caption": "Coordinator color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "RouterColor",
                            "caption": "Router color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        },
                        {
                            "type": "SelectColor",
                            "name": "EndDeviceColor",
                            "caption": "End device color",
                            "allowTransparent": true,
                            "transparentCaption": "Automatic (theme)"
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectColor",
                            "name": "LqiLowColor",
                            "caption": "LQI 0 color"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LqiMidColor",
                            "caption": "LQI 128 color"
                        },
                        {
                            "type": "SelectColor",
                            "name": "LqiHighColor",
                            "caption": "LQI 255 color"
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Refresh exported network map",
            "onClick": "ECGZ_RefreshGraph($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Zigbee graph is ready"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Network map source or filters are invalid"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Zigbee graph design is invalid"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "No active EChartsGateway is connected"
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Exported network map could not be read"
        }
    ]
}