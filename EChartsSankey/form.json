                {
                    "type": "Select",
                    "name": "Target",
                    "caption": "To node",
                    "options": [
                        {
                            "caption": "Select node",
                            "value": ""
                        }
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VariableID",
                    "caption": "Flow variable",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "ReverseNegative",
                    "caption": "Reverse negative flow"
                }
            ]
