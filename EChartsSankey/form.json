            "type": "Label",
            "caption": "One shared EChartsGateway is sufficient for all ECharts chart instances. Select the existing gateway when adding further charts."
        },
        {
            "type": "ValidationTextBox",
            "name": "Title",
            "caption": "Title"
        },
        {
            "type": "List",
            "name": "Nodes",
            "caption": "Sankey nodes",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "name": "Key",
                    "caption": "Node key",
                    "width": "220px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "Label",
                    "caption": "Node label",
                    "width": "320px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ],
            "form": [
                {
                    "type": "ValidationTextBox",
                    "name": "Key",
                    "caption": "Node key"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Label",
                    "caption": "Node label"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Create nodes first. Keys start with a letter and contain up to 40 letters, digits, underscores or hyphens. Labels may be repeated."
        },
        {
            "type": "List",
            "name": "Sources",
            "caption": "Sankey connections",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "name": "Source",
                    "caption": "From node",
                    "width": "250px",
                    "add": "",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Select node",
                                "value": ""
                            }
                        ]
                    }
                },
                {
                    "name": "Target",
                    "caption": "To node",
                    "width": "250px",
                    "add": "",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Select node",
                                "value": ""
                            }
                        ]
                    }
                },
                {
                    "name": "VariableID",
                    "caption": "Flow variable",
                    "width": "320px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable",
                        "validVariableTypes": [
                            1,
                            2
                        ]
                    }
                },
                {
                    "name": "ReverseNegative",
                    "caption": "Reverse negative flow",
                    "width": "210px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
